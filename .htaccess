# ACTU EYES - actueyes-montreuil.fr
# URL canonique : https://actueyes-montreuil.fr (sans www)
# Regroupe les 4 variantes du site sur une seule adresse, en 301.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Forcer HTTPS
# La 2e condition couvre le cas d'un proxy qui termine le TLS
# (sinon %{HTTPS} n'est jamais "on" cote Apache).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://actueyes-montreuil.fr%{REQUEST_URI} [R=301,L]

# 2. Supprimer le www
RewriteCond %{HTTP_HOST} ^www\.actueyes-montreuil\.fr$ [NC]
RewriteRule ^ https://actueyes-montreuil.fr%{REQUEST_URI} [R=301,L]


# 3. Articles retirés le 30/10/2026 (hors ligne éditoriale) : redirection
#    permanente vers l'article qui les remplace. Le serveur garde les anciens
#    fichiers (mise en ligne sans --delete) : ces règles passent avant eux.
RewriteRule ^actualites/rapport-igas-igf-fraude-remboursements-optiques-ia\.html$ https://actueyes-montreuil.fr/actualites/lunettes-100-sante-qualite-verres-montures.html [R=301,L]
RewriteRule ^actualites/fraude-remboursements-optiques-proces-paris-2027\.html$ https://actueyes-montreuil.fr/actualites/lunettes-c2s-parcours-sans-avance-de-frais.html [R=301,L]
RewriteRule ^actualites/alan-reseau-optique-ferme-janvier-2027\.html$ https://actueyes-montreuil.fr/actualites/montures-100-sante-metal-plastique-homme-femme.html [R=301,L]
RewriteRule ^actualites/rapport-experts-transfert-optique-mutuelles-assurance-maladie\.html$ https://actueyes-montreuil.fr/actualites/renouveler-lunettes-tous-les-deux-ans-sans-frais.html [R=301,L]
RewriteRule ^actualites/fermeture-oxantis-tiers-payant-optique-octobre-2026\.html$ https://actueyes-montreuil.fr/actualites/lunettes-enfant-c2s-choix-formes-couleurs.html [R=301,L]
RewriteRule ^actualites/publicite-optique-projet-interdiction-arrete-2026\.html$ https://actueyes-montreuil.fr/actualites/lentilles-contact-c2s-que-pouvez-vous-avoir.html [R=301,L]
RewriteRule ^actualites/facturation-electronique-obligatoire-opticiens-2026\.html$ https://actueyes-montreuil.fr/actualites/delais-fabrication-lunettes-selon-verres.html [R=301,L]
RewriteRule ^actualites/opticiens-ehpad-examens-vue-decret-2026\.html$ https://actueyes-montreuil.fr/actualites/mal-voir-nuit-volant-changement-heure.html [R=301,L]
RewriteRule ^actualites/teleexpertise-optique-glaucome-risque-snof-2026\.html$ https://actueyes-montreuil.fr/actualites/glaucome-signes-depistage-quand-consulter.html [R=301,L]
RewriteRule ^actualites/snof-plaintes-ordinales-teleexpertise-glaucome\.html$ https://actueyes-montreuil.fr/actualites/yeux-secs-hiver-chauffage-que-faire.html [R=301,L]
RewriteRule ^actualites/essilorluxottica-gouvernance-del-vecchio-depart-2026\.html$ https://actueyes-montreuil.fr/actualites/quelle-monture-choisir-forme-visage.html [R=301,L]
RewriteRule ^actualites/essilorluxottica-cliniques-ophtalmologiques-medtech-italie\.html$ https://actueyes-montreuil.fr/actualites/lunettes-metal-plastique-acetate-titane.html [R=301,L]
RewriteRule ^actualites/coopervision-vision-centre-pipeline-lentilles-2026\.html$ https://actueyes-montreuil.fr/actualites/debuter-lentilles-contact-temps-adaptation.html [R=301,L]
RewriteRule ^actualites/maui-jim-premiere-collection-optique-correctrice\.html$ https://actueyes-montreuil.fr/actualites/lunettes-soleil-a-la-vue-options.html [R=301,L]

</IfModule>

# ---------------------------------------------------------------------------
# Lot 1 du 27/10/2026 — vitesse (PageSpeed signalait ~800 Kio re-telecharges
# a chaque visite faute de mise en cache). Chaque bloc est entoure d'un
# IfModule : si le module n'existe pas chez l'hebergeur, la regle est ignoree
# sans erreur.
# ---------------------------------------------------------------------------

# Page d'erreur du site (generee par build.py, en noindex)
ErrorDocument 404 /404.html

# Compression des fichiers texte
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Type MIME du WebP (au cas ou le serveur ne le connaitrait pas)
<IfModule mod_mime.c>
AddType image/webp .webp
</IfModule>

# Duree de conservation dans le navigateur
#  - pages HTML : jamais en cache (une mise en ligne est visible tout de suite)
#  - site.css : appele avec ?v=<empreinte>, change de nom a chaque modification -> 1 an
#  - images : 30 jours (une image remplacee sous le meme nom peut mettre
#    jusqu'a 30 jours a apparaitre chez un visiteur deja venu)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|htm)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
